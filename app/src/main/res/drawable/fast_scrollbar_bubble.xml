<?xml version="1.0" encoding="utf-8"?>
<!-- White pill; the layout draws its letter in ?attr/colorOnPrimary (black). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pure_white" />
    <corners android:radius="@dimen/radius_card" />
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp" />
</shape>

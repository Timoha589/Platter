<?xml version="1.0" encoding="utf-8"?>
<!--
    The search field itself. DESIGN.md "Search Input": the graphite card layer
    (#1F1F1F) taken to the 500dp input radius, with no border and no shadow, so
    the pill reads as a recess in the black canvas rather than a raised control.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/graphite" />
    <corners android:radius="@dimen/radius_pill" />
</shape>

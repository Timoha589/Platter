<?xml version="1.0" encoding="utf-8"?>
<!-- The page's one action - download what the library is missing - with the
     day's quota under it, so the cost is in view before the tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/content_gutter"
    android:paddingTop="@dimen/spacing_20"
    android:paddingEnd="@dimen/content_gutter"
    android:paddingBottom="@dimen/spacing_8">

    <Button
        android:id="@+id/deezer_page_download_button"
        style="@style/Widget.Platter.Button.Pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/spacing_8"
        app:iconSize="18dp" />

    <TextView
        android:id="@+id/deezer_page_quota"
        style="@style/LabelSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_8"
        android:visibility="gone" />
</LinearLayout>

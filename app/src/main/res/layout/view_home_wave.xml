<?xml version="1.0" encoding="utf-8"?>
<!--  My Wave: the one hero card of the home screen. The waves behind the text
      are drawn from what is playing (WaveView), the green button is the play
      action DESIGN.md reserves green for.  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wave_card"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:layout_marginStart="@dimen/content_gutter"
    android:layout_marginTop="@dimen/spacing_16"
    android:layout_marginEnd="@dimen/content_gutter"
    android:layout_marginBottom="@dimen/spacing_8"
    android:background="@drawable/bg_wave_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <com.cappielloantonio.tempo.helper.view.WaveView
        android:id="@+id/wave_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginEnd="84dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_16">

        <TextView
            android:id="@+id/wave_title"
            style="@style/TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wave_title"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/wave_subtitle"
            style="@style/TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/wave_subtitle_idle" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/wave_play_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/spacing_16"
        android:background="@drawable/bg_circle_green"
        android:contentDescription="@string/wave_play_description"
        android:scaleType="center"
        android:src="@drawable/ic_play"
        android:tint="@color/void_black" />

    <ProgressBar
        android:id="@+id/wave_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="30dp"
        android:indeterminateTint="@color/void_black"
        android:visibility="gone" />
</FrameLayout>

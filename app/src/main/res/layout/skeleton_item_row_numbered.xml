<?xml version="1.0" encoding="utf-8"?>
<!--
    Placeholder for one track on an album page (item_horizontal_track without
    its cover): the row's 52dp, a short stripe where the track number sits in
    the middle of its 52dp column, and the title and subtitle lines.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/spacing_4"
    android:paddingBottom="@dimen/spacing_4">

    <FrameLayout
        android:layout_width="@dimen/cover_row"
        android:layout_height="@dimen/cover_row"
        android:layout_marginStart="@dimen/content_gutter">

        <View
            android:layout_width="16dp"
            android:layout_height="@dimen/skeleton_line_title"
            android:layout_gravity="center"
            android:background="@drawable/skeleton_line" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rail_card_gap"
        android:orientation="vertical">

        <View
            android:layout_width="180dp"
            android:layout_height="@dimen/skeleton_line_title"
            android:background="@drawable/skeleton_line" />

        <View
            android:layout_width="108dp"
            android:layout_height="@dimen/skeleton_line_meta"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/skeleton_line" />
    </LinearLayout>
</LinearLayout>

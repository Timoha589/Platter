<?xml version="1.0" encoding="utf-8"?>
<!--
    What the player's bottom right button opens: what can be done with the
    track that is playing. The actions used to be buttons of their own around
    the player; here they are rows, the way the song sheet has them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/player_more_title"
        style="@style/LabelMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/player_more_artist"
        style="@style/LabelSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/player_more_add_to_playlist"
        style="@style/LabelMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/player_more_add_to_playlist" />

    <TextView
        android:id="@+id/player_more_download"
        style="@style/LabelMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/player_more_download" />

    <TextView
        android:id="@+id/player_more_dislike"
        style="@style/LabelMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/player_more_dislike" />

    <TextView
        android:id="@+id/player_more_equalizer"
        style="@style/LabelMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/player_more_equalizer" />

    <TextView
        android:id="@+id/player_more_track_info"
        style="@style/LabelMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/player_more_track_info" />

</LinearLayout>

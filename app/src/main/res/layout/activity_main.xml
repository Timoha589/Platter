<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />

        <!--
            clickable, with nothing to click: the sheet has to swallow every
            touch its own content did not take. A CoordinatorLayout hands an
            unconsumed event to the next child down, which here is the nav host,
            so a tap landing between the player's buttons used to reach the
            screen behind it and start whatever sat under the finger. That
            happens whenever the vertical pager stops consuming touches — it is
            disabled on the lyrics page so the lyrics can scroll — and the sheet
            itself had no background and no click handling to fall back on.
        -->
        <FrameLayout
            android:id="@+id/player_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            app:behavior_hideable="true"
            app:behavior_peekHeight="@dimen/bottom_sheet_behavior_peek_height"
            app:layout_behavior="@string/bottom_sheet_behavior" />

        <!-- Spotify's bar sits on the black canvas and spreads edge to edge;
             metrics and styling come from Widget.Platter.BottomNavigation. -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:layout_gravity="bottom"
            android:visibility="gone"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <TextView
        android:id="@+id/offline_mode_text_view"
        style="@style/NoConnectionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/activity_info_offline_mode"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>

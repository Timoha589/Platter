<?xml version="1.0" encoding="utf-8"?>
<!--
    One track as the mini player shows it: sleeve, title, artist. Three of these
    sit stacked side by side in the header strip - the previous track, the one
    playing, the next - so a sideways drag can carry the whole row rather than
    swap its contents when it lands.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mini_player_cover_image"
        style="@style/Widget.Platter.Cover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/mini_player_title_label"
        style="@style/LabelMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        tools:text="Title"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@+id/mini_player_artist_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mini_player_cover_image"
        app:layout_constraintTop_toTopOf="@+id/mini_player_cover_image" />

    <TextView
        android:id="@+id/mini_player_artist_label"
        style="@style/LabelSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        tools:text="Artist"
        app:layout_constraintBottom_toBottomOf="@+id/mini_player_cover_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mini_player_cover_image"
        app:layout_constraintTop_toBottomOf="@+id/mini_player_title_label" />

</androidx.constraintlayout.widget.ConstraintLayout>

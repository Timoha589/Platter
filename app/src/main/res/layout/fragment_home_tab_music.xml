                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/rail_end_padding"
                    android:paddingBottom="@dimen/spacing_8"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Playlists -->
            <LinearLayout
                android:id="@+id/pinned_playlists_sector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/pinned_playlists_text_view"
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/section_header_top"
                    android:paddingEnd="@dimen/content_gutter"
                    android:text="@string/home_title_pinned_playlists"
                    android:paddingBottom="@dimen/section_header_bottom" />

                <com.cappielloantonio.tempo.helper.view.SkeletonView
                    android:id="@+id/pinned_playlists_skeleton"
                    style="@style/Widget.Platter.Skeleton.List"
                    app:skeletonCount="3"

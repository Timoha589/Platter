                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/spacing_4"
                    android:visibility="gone" />

                <com.cappielloantonio.tempo.helper.view.PageDotsView
                    android:id="@+id/starred_artists_page_dots"
                    style="@style/PageDots" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/home_new_releases_sector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!--  New releases  -->
                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/section_header_top"
                    android:paddingEnd="@dimen/content_gutter"
                    android:text="@string/home_title_new_releases"
                    android:paddingBottom="@dimen/section_header_bottom" />

                <com.cappielloantonio.tempo.helper.view.SkeletonView
                    android:id="@+id/new_releases_skeleton"
                    style="@style/Widget.Platter.Skeleton.List"
                    app:skeletonCount="5"
                    app:skeletonItem="@layout/skeleton_item_row" />

                <com.cappielloantonio.tempo.helper.recyclerview.ContentRecyclerView
                    android:id="@+id/new_releases_recycler_view"
                    android:nestedScrollingEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/spacing_4"
                    android:visibility="gone" />

                <com.cappielloantonio.tempo.helper.view.PageDotsView
                    android:id="@+id/new_releases_page_dots"
                    style="@style/PageDots" />
            </LinearLayout>

            <!-- Fashback -->
            <LinearLayout
                android:id="@+id/home_flashback_sector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!--  Label and button  -->
                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/section_header_top"
                    android:paddingEnd="@dimen/content_gutter"
                    android:text="@string/home_title_flashback"
                    android:paddingBottom="@dimen/section_header_bottom" />

                <com.cappielloantonio.tempo.helper.view.SkeletonView
                    android:id="@+id/years_skeleton"
                    style="@style/Widget.Platter.Skeleton.Rail"
                    app:skeletonCount="3"
                    app:skeletonItem="@layout/skeleton_item_rail_plate" />

                <com.cappielloantonio.tempo.helper.recyclerview.ContentRecyclerView
                    android:id="@+id/years_recycler_view"
                    android:nestedScrollingEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/rail_end_padding"
                    android:visibility="gone" />
            </LinearLayout>


            <!--  Most played albums -->
            <LinearLayout
                android:id="@+id/home_most_played_albums_sector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!--  Label and button  -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/section_header_top"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/section_header_bottom"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/most_played_albums_text_view_refreshable"
                        style="@style/TitleLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_title_most_played" />

                    <TextView
                        android:id="@+id/most_played_albums_text_view_clickable"
                        style="@style/SectionAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_title_most_played_see_all_button" />
                </LinearLayout>

                <com.cappielloantonio.tempo.helper.view.SkeletonView
                    android:id="@+id/most_played_albums_skeleton"
                    style="@style/Widget.Platter.Skeleton.Rail"
                    app:skeletonCount="3"
                    app:skeletonItem="@layout/skeleton_item_rail_square" />

                <com.cappielloantonio.tempo.helper.recyclerview.ContentRecyclerView

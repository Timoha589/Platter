                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/rail_end_padding"
                    android:paddingBottom="@dimen/spacing_8"
                    android:visibility="gone" />
            </LinearLayout>

            <!--  Recently played albums -->
            <LinearLayout
                android:id="@+id/home_recently_played_albums_sector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!--  Label and button  -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/section_header_top"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/section_header_bottom"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/recently_played_albums_text_view_refreshable"
                        style="@style/TitleLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_title_last_played" />


                    <TextView
                        android:id="@+id/recently_played_albums_text_view_clickable"
                        style="@style/SectionAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_title_last_played_see_all_button" />

                </LinearLayout>

                <com.cappielloantonio.tempo.helper.view.SkeletonView
                    android:id="@+id/recently_played_albums_skeleton"
                    style="@style/Widget.Platter.Skeleton.Rail"
                    app:skeletonCount="3"
                    app:skeletonItem="@layout/skeleton_item_rail_square" />

                <com.cappielloantonio.tempo.helper.recyclerview.ContentRecyclerView
                    android:id="@+id/recently_played_albums_recycler_view"
                    android:nestedScrollingEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/rail_end_padding"
                    android:paddingBottom="@dimen/spacing_8"
                    android:visibility="gone" />
            </LinearLayout>

            <!--  Recently added albums -->
            <LinearLayout
                android:id="@+id/home_recently_added_albums_sector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!--  Label and button  -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/section_header_top"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/section_header_bottom"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/recently_added_albums_text_view_refreshable"
                        style="@style/TitleLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_title_recently_added" />


                    <TextView
                        android:id="@+id/recently_added_albums_text_view_clickable"
                        style="@style/SectionAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_title_recently_added_see_all_button" />

                </LinearLayout>

                <com.cappielloantonio.tempo.helper.view.SkeletonView
                    android:id="@+id/recently_added_albums_skeleton"
                    style="@style/Widget.Platter.Skeleton.Rail"
                    app:skeletonCount="3"
                    app:skeletonItem="@layout/skeleton_item_rail_square" />


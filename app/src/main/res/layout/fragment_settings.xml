<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings list used to open with no chrome at all - no title, and nothing
    but the system gesture to get back. It gets the same black toolbar every
    other detail page in the app has, with the preference list hosted under it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/void_black"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/menu_settings_button"
        app:titleTextAppearance="@style/TextAppearance.Platter.ToolbarTitle" />

    <FrameLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

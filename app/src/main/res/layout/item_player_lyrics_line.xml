<?xml version="1.0" encoding="utf-8"?>
<!--
    One timed line. Each line is its own view so the active one can be faded on
    its own - a single TextView carrying the whole lyric can only be restyled by
    rewriting its spans, which cannot be animated and relays out the block on
    every frame.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/BodyLarge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/inter_bold"
    android:gravity="center"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:textColor="@color/lyricsTextColor"
    android:textSize="@dimen/lyrics_text_size" />

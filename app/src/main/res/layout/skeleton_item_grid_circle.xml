<?xml version="1.0" encoding="utf-8"?>
<!--
    Placeholder for one artist in a two-column catalogue grid
    (item_library_catalogue_artist): a round photo the width of its column and
    the name centred under it, with the card's own 12dp above and 16dp below.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="19dp">

    <View
        android:id="@+id/skeleton_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/skeleton_block_circle"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="96dp"
        android:layout_height="@dimen/skeleton_line_title"
        android:layout_marginTop="15dp"
        android:background="@drawable/skeleton_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeleton_cover" />
</androidx.constraintlayout.widget.ConstraintLayout>

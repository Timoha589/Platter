<?xml version="1.0" encoding="utf-8"?>
<!--
    Signing in to Timoha Premium: the address is known, so only who you are is
    asked. Inputs are the graphite pills of DESIGN.md "Search Input", the
    action the white pill - full width, as the only thing left to do here.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingBottom="@dimen/spacing_24">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tint="@color/steel" />

        <TextView
            style="@style/HeadlineLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_server_name" />

        <TextView
            style="@style/TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/spacing_4"
            android:text="@string/premium_login_subtitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/premium_username_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/premium_username_edit_text"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:autofillHints="username"
                android:fontFamily="@font/inter_regular"
                android:hint="@string/server_signup_dialog_hint_username"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:paddingStart="@dimen/spacing_20"
                android:paddingTop="0dp"
                android:paddingEnd="@dimen/spacing_20"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/premium_password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/mist"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/premium_password_edit_text"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:autofillHints="password"
                android:fontFamily="@font/inter_regular"
                android:hint="@string/server_signup_dialog_hint_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:paddingStart="@dimen/spacing_20"
                android:paddingTop="0dp"
                android:paddingEnd="@dimen/spacing_20"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/premium_error_text_view"
            style="@style/InterFontFamily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:paddingStart="@dimen/spacing_20"
            android:paddingTop="@dimen/spacing_12"
            android:paddingEnd="@dimen/spacing_20"
            android:textColor="?attr/colorError"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/premium_sign_in_button"
            style="@style/Widget.Platter.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/premium_server_log_in" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

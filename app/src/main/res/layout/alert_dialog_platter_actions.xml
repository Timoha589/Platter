<?xml version="1.0" encoding="utf-8"?>
<!--
    The action row of every MaterialAlertDialog in the app. Material's own
    version wraps the buttons in a ScrollView, which AlertDialogLayout is then
    free to squeeze down to a button and a half whenever the buttons stack and
    the content is tall - the actions ended up scrolling inside the dialog.
    DialogButtonPanel always claims its full height instead, so the buttons stay
    put and the content above them scrolls.

    ButtonBarLayout still does the rest the Material way: side by side at the
    end of the row, with the neutral action (Reset, Delete) at the start, and
    stacked end-aligned with the confirming action on top only when the labels
    are too long to fit in one line.
-->
<com.cappielloantonio.tempo.helper.view.DialogButtonPanel xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/buttonPanel"
    style="?attr/buttonBarStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.ButtonBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:layoutDirection="locale"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dialog_actions_padding_horizontal"
        android:paddingRight="@dimen/dialog_actions_padding_horizontal"
        android:paddingTop="@dimen/m3_alert_dialog_action_top_padding"
        android:paddingBottom="@dimen/m3_alert_dialog_action_bottom_padding">

        <Button
            android:id="@android:id/button3"
            style="?attr/buttonBarNeutralButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <android.widget.Space
            android:id="@+id/spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="invisible" />

        <Button
            android:id="@android:id/button2"
            style="?attr/buttonBarNegativeButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@android:id/button1"
            style="?attr/buttonBarPositiveButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </androidx.appcompat.widget.ButtonBarLayout>

</com.cappielloantonio.tempo.helper.view.DialogButtonPanel>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Placeholder for one 52dp list row (item_horizontal_track / _album). Matches
    the row's own 4dp vertical padding, so five of these measure exactly the
    300dp a five-row page measures.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/spacing_4"
    android:paddingBottom="@dimen/spacing_4">

    <View
        android:layout_width="@dimen/cover_row"
        android:layout_height="@dimen/cover_row"
        android:layout_marginStart="@dimen/content_gutter"
        android:background="@drawable/skeleton_block" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rail_card_gap"
        android:orientation="vertical">

        <View
            android:layout_width="180dp"
            android:layout_height="@dimen/skeleton_line_title"
            android:background="@drawable/skeleton_line" />

        <View
            android:layout_width="108dp"
            android:layout_height="@dimen/skeleton_line_meta"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/skeleton_line" />
    </LinearLayout>
</LinearLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
        As in portrait: three sleeves, the track playing and the one on either
        side of it parked a page away, and the page cuts what is outside it.

        Here the page is wider than the sleeve is tall, so the sleeve is held to
        the right, where the margin of the page (24dp, as on the other three
        sides) puts it. Centred, it floated in its half with more than twice
        that room on its right.
    -->
    <FrameLayout
        android:id="@+id/now_playing_cover_strip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/now_playing_song_cover_previous"
            style="@style/Widget.Platter.Cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/now_playing_song_cover_image_view"
            style="@style/Widget.Platter.Cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/now_playing_song_cover_next"
            style="@style/Widget.Platter.Cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

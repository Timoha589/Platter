<?xml version="1.0" encoding="utf-8"?>
<!--
    Spotify type scale (DESIGN.md "Tokens — Typography").

    SpotifyMixUI is proprietary; the reference names Inter as the substitute and
    Inter is already bundled in res/font. Weights are limited to 400 / 600 / 700
    and headings are capped at 24sp — "Do not use typography larger than 24px
    for headings. Spotify's hierarchy is compact."

    Weight is expressed by pointing android:fontFamily at the concrete Inter
    face rather than by android:textFontWeight: that attribute only exists from
    API 28, and minSdk here is 24, so on Android 7.0-8.1 every weight silently
    collapsed to regular and the whole hierarchy disappeared. Naming the face
    works on every supported release (AppCompat resolves font resources back to
    API 14).
-->
<resources>

    <style name="InterFontFamily">
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- ==================== Headings — SpotifyMixUITitle ==================== -->
    <!-- Section headings: 'Made for you', 'Trending songs'. 24sp / 700 / white. -->
    <style name="HeadlineLarge" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <style name="HeadlineMedium" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <style name="HeadlineSmall" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <!--
        Section header row above every content rail.

        DESIGN.md's 24px heading is a desktop measurement: on a 360dp-wide
        phone a 24sp bold heading over a 160dp card rail is wider than the card
        it introduces and pushes two sections' worth of content off screen.
        Spotify's own Android client sets rail headings around 20sp, which is
        what this uses - still the largest face in the app, still under the
        "never above 24" cap, but it lets the artwork lead.
    -->
    <style name="TitleLarge" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <!-- 'Show all' / 'Shuffle all' links and section subtitles -->
    <style name="TitleMedium" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/subtitleTextColor</item>
    </style>

    <style name="TitleSmall" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/subtitleTextColor</item>
    </style>

    <!-- ==================== Labels — SpotifyMixUI ==================== -->
    <!-- Album / playlist page title in the collapsing header -->
    <style name="LabelExtraLarge" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <style name="LabelLarge" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <!-- Primary row / card title: song name, album name. 14sp / 600 / white. -->
    <style name="LabelMedium" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_semi_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <!-- Secondary metadata: artist name, duration, year. 12sp / 400 / mist. -->
    <style name="LabelSmall" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/subtitleTextColor</item>
    </style>

    <style name="LabelExtraSmall" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/subtitleTextColor</item>
    </style>

    <!-- ==================== Body ==================== -->
    <!-- Lyrics view — the one place a larger face is warranted -->
    <style name="BodyLarge" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <style name="BodyMedium" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

    <style name="BodySmall" parent="InterFontFamily">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/titleTextColor</item>
    </style>

</resources>
